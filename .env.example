# Copy to .env. Replace every secret before exposing Cignal to the internet.
APP_ENV=development
DEMO_MODE=false
APP_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_SECRET_KEY=replace-with-a-different-at-least-32-random-secret
JWT_ACCESS_MINUTES=20
JWT_REFRESH_DAYS=14
MFA_REQUIRED=true
RATE_LIMIT_FAIL_CLOSED=true
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

POSTGRES_DB=cignal
POSTGRES_USER=cignal
POSTGRES_PASSWORD=replace-this-database-password
DATABASE_URL=postgresql+psycopg://cignal:replace-this-database-password@db:5432/cignal
REDIS_PASSWORD=replace-this-redis-password
REDIS_URL=redis://:replace-this-redis-password@redis:6379/0
API_INTERNAL_URL=http://api:8000
API_PUBLIC_URL=http://localhost:8000
UI_PUBLIC_URL=http://localhost:8080

EVIDENCE_DIR=/data/evidence
MAX_UPLOAD_MB=10
RETENTION_DAYS=365

# Optional provider credentials. The app remains usable without them.
IMD_API_BASE_URL=
IMD_API_TOKEN=
INDIA_GOV_API_BASE_URL=
INDIA_GOV_API_TOKEN=
BHUVAN_GEOJSON_URL=
BHUVAN_API_TOKEN=
NASA_FIRMS_MAP_KEY=
NASA_EONET_ENABLED=true
# Optional SACHET CAP subscription/feed identifiers, separated by semicolons.
SACHET_CAP_IDENTIFIERS=
OPEN_METEO_ENABLED=true
GDACS_ENABLED=true
USGS_ENABLED=true
AUTHORIZED_RSS_FEEDS=
SOCIAL_API_BASE_URL=
SOCIAL_API_TOKEN=

# SMTP is optional. Notifications remain in-app without SMTP configuration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Optional Web Push (generate VAPID keys with pywebpush tooling).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUBJECT=mailto:admin@example.invalid

# Optional S3-compatible evidence storage. Local filesystem is the default.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=cignal-evidence
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Scheduler, connector reliability and model controls
INGEST_INTERVAL_MINUTES=30
# Optional per-provider overrides in SOURCE_TYPE=SECONDS;SOURCE_TYPE=SECONDS format.
# Valid range: 60-86400 seconds. Example: usgs=900;nasa_eonet=1800
INGEST_SOURCE_INTERVAL_OVERRIDES=
INGEST_SCHEDULER_TICK_SECONDS=30
INGEST_JOB_TIMEOUT_SECONDS=1200
INGEST_JOB_LEASE_SECONDS=1800
INGEST_RETRY_BACKOFF_BASE_SECONDS=60
INGEST_RETRY_BACKOFF_MAX_SECONDS=21600
INTEGRATION_RETRY_ATTEMPTS=3
INTEGRATION_RETRY_BASE_DELAY_SECONDS=0.5
INTEGRATION_RETRY_MAX_DELAY_SECONDS=8.0
# Continuous candidate-only event discovery; no automatic incident verification or response.
CONTINUOUS_EVENT_DISCOVERY_ENABLED=true
CONTINUOUS_EVENT_DISCOVERY_QUIET_SECONDS=120
CONTINUOUS_EVENT_DISCOVERY_WINDOW_HOURS=72
CONTINUOUS_EVENT_DISCOVERY_MAX_REPORTS=300
BACKGROUND_JOB_MAX_EXECUTION_ATTEMPTS=8
BACKGROUND_JOB_DISPATCH_MAX_ATTEMPTS=12
BACKGROUND_JOB_LEASE_GRACE_SECONDS=120
BACKGROUND_JOB_RECONCILE_GRACE_SECONDS=120
AI_ENABLE_SKLEARN=true
AI_TEXT_MODEL_PATH=/data/models/disaster-text-v1.joblib
AI_VISION_MODEL_PATH=/data/models/disaster-vision-v1.joblib
AI_MAX_IMAGES_PER_REPORT=8
AI_ENABLE_TORCHVISION=false
AI_ENABLE_PRETRAINED_NLP=false
AI_NLP_MODEL_ID=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EVENT_PAIR_MODEL_PATH=./data/models/event-pair-v1.joblib
RETENTION_ENABLED=true
EVIDENCE_INTEGRITY_AUDIT_ENABLED=true
BACKUP_DIR=/data/backups
BACKUP_RETENTION_COUNT=14
